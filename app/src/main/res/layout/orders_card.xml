<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_marginTop="5dp"
    android:background="@drawable/topbox_design"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:layout_height="wrap_content">

    <!-- Order Header Information -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/order_design"
        android:padding="4dp">

        <TextView
            android:id="@+id/order_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="Date"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/order_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/order_date"
            android:text="Time"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/order_id_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/order_date"
            android:layout_marginTop="7dp"
            android:textStyle="bold"
            android:text="Order ID: " />

        <TextView
            android:id="@+id/order_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/order_date"
            android:layout_toEndOf="@+id/order_id_label"
            android:layout_marginTop="7dp"
            android:textStyle="bold"
            android:text="Identifier" />

        <TextView
            android:id="@+id/order_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Status"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/order_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/order_id"
            android:layout_marginTop="2dp"
            android:text="Address"
            android:textSize="17sp" />
    </RelativeLayout>

    <!-- Products List within the Order -->
    <LinearLayout
        android:id="@+id/products_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Product items will be added dynamically here -->

    </LinearLayout>
</LinearLayout>
