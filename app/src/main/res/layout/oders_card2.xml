<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_marginTop="5dp"
    android:layout_gravity="center_vertical"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/order_design"
        android:padding="10dp">

        <TextView
            android:id="@+id/name_space"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fertilizer type"
            android:textStyle="bold"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/order_name"
            android:background="@color/white"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="127dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/name_space"
            android:textAlignment="center"
            android:layout_marginTop="2dp"
            android:text="Name"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quantity_space"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="3dp"
            android:text="Fertilizer Quantity"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/order_count"
            android:layout_width="134dp"
            android:background="@color/white"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/quantity_space"
            android:layout_alignStart="@id/quantity_space"
            android:textAlignment="center"
            android:layout_marginTop="2dp"
            android:text="Count"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/destination_space"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/order_count"
            android:layout_marginTop="2dp"
            android:text="Destination"
            android:textStyle="bold"
            android:textSize="20sp" />


        <TextView
            android:id="@+id/order_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/destination_space"
            android:layout_marginTop="2dp"
            android:background="@color/white"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="Address"
            android:textSize="17sp" />








    </RelativeLayout>

</LinearLayout>