<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4A340D"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/topImage"
        android:layout_width="293dp"
        android:layout_height="195dp"
        android:contentDescription="topImage"
        android:src="@drawable/home2" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="match_parent"
        android:layout_height="147dp"
        android:layout_below="@+id/topImage"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="logo"
        android:src="@drawable/logo1" />



    <TextView
        android:layout_marginBottom="5dp"
        android:textAlignment="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shop the best fertilizer for your crops and get it delivered to your doorstep"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="#D7010700"
        android:textColor="#DDE8DC"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/logo"
        android:id="@+id/appTitle" />

    <TextView
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/bottom_logo"
        android:id="@+id/textview1"
        android:textAlignment="center"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="@string/get_started"
        android:clickable="true"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="20sp"
        android:background="@drawable/button_design"
         />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/bottom_logo"
        android:layout_width="322dp"
        android:layout_height="204dp"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="20dp"
        android:layout_alignParentEnd="true"
        android:contentDescription="bottom image"
        android:src="@drawable/home1" />

</RelativeLayout>