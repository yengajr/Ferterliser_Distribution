<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DistributorDashboard">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:layout_centerInParent="true">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check Orders"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/distributor_name"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/welcomeMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log out"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/appTitle"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/distributor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Distributor"
            android:textSize="25sp"
            android:padding="15dp"
            android:background="@drawable/topbox_design"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="13dp"/>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>