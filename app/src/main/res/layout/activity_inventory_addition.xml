<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".InventoryAddition">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="1dp"
                android:text="Add inventory"
                android:layout_gravity="center"
                android:textSize="20sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="#2ACDE6CE"
                >

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ImageView"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_marginTop="3dp"
                    android:layout_gravity="center"
                    android:background="#2ACDE6CE"
                    android:layout_alignParentTop="true"
                    android:layout_centerInParent="true"
                    app:strokeColor="#5BE461"
                    app:strokeWidth="3dp" />

                <TextView
                    android:id="@+id/category_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:text="Category"
                    android:layout_below="@+id/ImageView"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <Spinner
                    android:id="@+id/category"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:layout_below="@+id/category_text"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="1dp"
                    android:layout_toLeftOf="@id/add_category"
                    android:background="@drawable/spinner_design"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/add_category"
                    android:layout_width="wrap_content"
                    android:layout_height="51dp"
                    android:layout_marginBottom="1dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="20dp"
                    android:text="Add\nCategory"
                    android:layout_alignParentEnd="true"
                    android:textAlignment="center"
                    android:layout_below="@id/category_text"
                    android:layout_gravity="center"
                    android:textStyle="bold" />



                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textField_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/category"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:hint="Item Name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/item_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textField_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/textField_name"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:hint="Price">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textField_quantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/textField_price"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:hint="Quantity">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/quantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/description_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginStart="20dp"
                    android:text="Description"
                    android:textSize="18sp"
                    android:layout_below="@id/textField_quantity"
                    />


                <EditText
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/description_txt"
                    android:background="@drawable/spinner_design"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:hint="About the product"
                    android:inputType="textMultiLine"
                    android:lines="6"
                    android:maxLines="6"
                    android:scrollbars="vertical"
                    android:gravity="top"
                    android:autofillHints="notes" />

                <Button
                    android:id="@+id/add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/description"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="20dp"
                    android:text="Save"
                    android:textColor="@color/white"
                    android:background="@drawable/button_design" />


                <Button
                    android:id="@+id/discard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/description"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="20dp"
                    android:text="Discard"
                    android:textColor="@color/white"
                    android:background="@drawable/button_design" />



            </RelativeLayout>

        </LinearLayout>
    </ScrollView>
