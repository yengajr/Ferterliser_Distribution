<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UserDashboard">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome"
            android:textSize="20sp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="5dp"
            android:id="@+id/topTittle"
             />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="10dp"
            android:id="@+id/user_name"
            android:layout_below="@+id/topTittle"
             />

        <ImageButton
            android:id="@+id/cart1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="cart_button"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"
            android:layout_above="@id/searchView"
            android:layout_marginBottom="10dp"
            android:background="@color/transparent"
            android:src="@drawable/shopping_cart" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="55"
            android:id="@+id/cart_count"
            android:layout_above="@+id/cart1"
            android:layout_marginTop="10dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="22dp"
            android:textColor="@color/red"
            android:visibility="gone"
            />



        <SearchView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/searchView"
            android:layout_below="@+id/user_name"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="10dp"
            android:queryHint="Search for products"
            android:background="@drawable/spinner_design"
            android:iconifiedByDefault="false"
            android:layout_centerHorizontal="true"
            />

        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/searchView"
            android:layout_marginStart="15dp"
            android:background="@drawable/background_design"
            android:layout_marginEnd="15dp"
            android:layout_gravity="center"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/user_card_image"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/blue_circle"
                />

            <TextView
                android:id="@+id/announcementText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Todays Anouncement On Discounts"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/user_card_image"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:textStyle="bold" />

        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Porpular Brands"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"
            android:id="@+id/popular_brands"
            android:layout_below="@+id/relativeLayout"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/recyclerView"
            android:layout_below="@+id/popular_brands"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            />

        <TextView
            android:id="@+id/current_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="21dp"
            android:visibility="gone"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/button_shape"
            android:textSize="20sp"
            android:text="0.0" />


    </RelativeLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>